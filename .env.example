# ==============================================================================
# GraphMind — Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=info

# FastAPI Server Configuration
HOST=0.0.0.0
PORT=8300
FRONTEND_URL=http://localhost:3300


# AI Provider Configuration
# Supported providers: gemini, openai, mock
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.5-flash

# API Keys (Set at least one to enable live completions, or leave blank to use mock stream)
GEMINI_API_KEY=
OPENAI_API_KEY=

# PostgreSQL Database Configuration (Used in Phase 4 Persistence)
POSTGRES_USER=graphmind
POSTGRES_PASSWORD=graphmind_secret
POSTGRES_DB=graphmind_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://graphmind:graphmind_secret@localhost:5432/graphmind_db

# Redis Cache Configuration (Used in Phase 4 Persistence)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
