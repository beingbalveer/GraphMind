# ==============================================================================
# GraphMind Environment Configuration Template
# Copy this file to .env and configure your local or deployment secrets.
# ==============================================================================

# Server & Networking
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8300
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3300
NEXT_PUBLIC_API_URL=http://localhost:8300

# PostgreSQL 16 with pgvector & Redis
POSTGRES_USER=graphmind
POSTGRES_PASSWORD=graphmind_secret
POSTGRES_DB=graphmind_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://graphmind:graphmind_secret@localhost:5432/graphmind_db
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Storage Directory for uploaded workspace files
STORAGE_DIR=data/storage

# Default AI Model Provider (gemini, openai, anthropic, deepseek, ollama)
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.5-flash

# LLM Provider API Keys (Configure at least one)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Local Ollama Configuration (if using local models)
OLLAMA_BASE_URL=http://localhost:11434/v1
