# App Environment
ENVIRONMENT=development
LOG_LEVEL=info

# API Config
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-super-secret-key-for-development

# Database Config
POSTGRES_USER=graphmind
POSTGRES_PASSWORD=graphmind_secret
POSTGRES_DB=graphmind_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://graphmind:graphmind_secret@localhost:5432/graphmind_db

# Redis Config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Provider Config
DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=gemin key
OPENAI_API_KEY=your-openai-api-key-here
DEFAULT_MODEL=gemini-2.5-flash
