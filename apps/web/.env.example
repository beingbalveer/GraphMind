# Web-app client env. Copy to .env.local (gitignored).
# The repo-root .env covers the API/worker; NEXT_PUBLIC_* flags MUST live here
# because Next.js only reads env files from apps/web, not the repo root.
NEXT_PUBLIC_API_URL=http://localhost:8300
# Enables the researched roadmap generator wizard (async jobs pipeline).
NEXT_PUBLIC_ROADMAP_GENERATOR_ENABLED=true